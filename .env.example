# Plantilla de variables para el perfil postgres (Supabase o PostgreSQL propio). No contiene secretos.
# Copiar a .env (ignorado por Git) o definir en la terminal / Run Configuration de IntelliJ.
# Spring Boot NO lee archivos .env por sí solo.

SPRING_PROFILES_ACTIVE=postgres

# Conexión de la aplicación. Copiar host, puerto y usuario EXACTOS del panel de Supabase
# (Connect > Session pooler). La URL debe empezar con jdbc:postgresql:// y no incluir usuario ni clave.
DB_URL=jdbc:postgresql://<HOST>:<PUERTO>/postgres?sslmode=verify-full&sslrootcert=<RUTA_AL_CERTIFICADO_CA>
DB_USERNAME=<USUARIO>
DB_PASSWORD=
DB_POOL_SIZE=5
DB_LOCK_TIMEOUT=5s

# Opcional: ejecutar las migraciones de Flyway por otra conexión (por ejemplo, la directa).
# Si se define la URL, también deben definirse usuario y contraseña: Flyway no reutiliza los de DB_*.
#SPRING_FLYWAY_URL=jdbc:postgresql://<HOST_DIRECTO>:5432/postgres?sslmode=verify-full&sslrootcert=<RUTA_AL_CERTIFICADO_CA>
#SPRING_FLYWAY_USER=<USUARIO_DIRECTO>
#SPRING_FLYWAY_PASSWORD=

# Cuentas de acceso a la API (obligatorias fuera del perfil dev)
APP_USER_NAME=
APP_USER_PASSWORD=
APP_ADMIN_NAME=
APP_ADMIN_PASSWORD=
